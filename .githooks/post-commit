#!/usr/bin/env bash
# post-commit: nothing repo-specific; hands over to the global hook of the same name (Git LFS).
# Docs: .githooks/README.md.
set -euo pipefail

# shellcheck source=lib.sh
source "${BASH_SOURCE[0]%/*}/lib.sh"

usage() {
  cat <<USAGE
Usage: .githooks/post-commit [-h|--help]

Run by git. Hands over to the global post-commit hook (Git LFS), if there is one.
Docs: .githooks/README.md.

Exit status: 0 done, 2 usage error, otherwise the global hook's.
USAGE
}

main() {
  parse_hook_args 0 0 "$@"
  enter_repo
  run_global_hook "$@"
}

main "$@"
