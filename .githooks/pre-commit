#!/usr/bin/env bash
# pre-commit: auto-format/fix the staged files, re-stage them, then run every fast check.
# Docs: .githooks/README.md.
set -euo pipefail

# shellcheck source=lib.sh
source "${BASH_SOURCE[0]%/*}/lib.sh"

readonly UV_INSTALL_HINT="brew install uv, or https://docs.astral.sh/uv/"

usage() {
  cat <<USAGE
Usage: .githooks/pre-commit [-h|--help]

Run by git commit. Auto-fixes the staged files and re-stages them (a file with
unstaged edits is only checked), then runs "npm run verify -- --app" in astro/,
plus --python when files under scripts/ are staged and --shell when the hooks
are. Docs: .githooks/README.md.

Exit status: 0 passed, 1 a check failed, 2 usage error, 130 interrupted.
USAGE
}

# Fills STAGED with the staged changes under directory $1 that pass diff filter $2, as
# repo-relative paths. NUL-separated, so git does not quote unusual file names.
STAGED=()
read_staged() {
  local list path
  list=$(mktemp "${TMPDIR:-/tmp}/pre-commit.XXXXXX")
  TEMP_FILES+=("$list")
  git diff --cached --name-only -z --diff-filter="$2" -- "$1" >"$list"
  STAGED=()
  while IFS= read -r -d '' path; do
    STAGED+=("$path")
  done <"$list"
}

# Fills FIXABLE with the staged files under directory $1 that may be rewritten. A file with
# unstaged edits can't be fixed and re-staged without sweeping those edits into the commit,
# so it is only checked.
FIXABLE=()
read_fixable() {
  local path
  FIXABLE=()
  # Added, copied, modified or renamed: the files that still exist.
  read_staged "$1" ACMR
  ((${#STAGED[@]})) || return 0
  for path in "${STAGED[@]}"; do
    [[ -f "$path" ]] || continue
    # Literal pathspecs: "[slug].astro" is a file name here, not a pattern.
    if ! git --literal-pathspecs diff --quiet -- "$path"; then
      info "$path has unstaged edits: checking only, not auto-fixing"
      continue
    fi
    FIXABLE+=("$path")
  done
}

restage_fixable() {
  git --literal-pathspecs add -- "${FIXABLE[@]}"
}

# The fixers' failures are ignored: the checks that follow report what is left.
autofix_app() {
  local path file json=() code=() css=()
  read_fixable astro
  ((${#FIXABLE[@]})) || return 0
  for path in "${FIXABLE[@]}"; do
    file="${path#astro/}"
    case "$file" in
      src/data/*.json) json+=("$file") ;; # case globs match across "/"
      *.ts | *.astro) code+=("$file") ;;
      src/styles/*.css) css+=("$file") ;; # "*" also covers the subfolders
      *) ;;
    esac
  done

  info "auto-fixing staged files in astro/"
  (
    cd astro
    if ((${#json[@]})); then npx --no-install prettier --log-level warn --write "${json[@]}"; fi
    if ((${#code[@]})); then npx --no-install eslint --fix "${code[@]}" || true; fi
    if ((${#css[@]})); then npx --no-install stylelint --fix "${css[@]}" || true; fi
  ) </dev/null
  restage_fixable
}

autofix_python() {
  local path python=()
  read_fixable scripts
  ((${#FIXABLE[@]})) || return 0
  for path in "${FIXABLE[@]}"; do
    case "$path" in
      *.py) python+=("${path#scripts/}") ;;
      *) ;;
    esac
  done
  ((${#python[@]})) || return 0

  info "auto-formatting staged Python files"
  (cd scripts && uv run ruff format -- "${python[@]}") </dev/null || true
  restage_fixable
}

# Sets HAS_PYTHON_SECTION when files under scripts/ are staged. Deletions count: they can
# break what is left. uv is only insisted on when Python itself changed.
HAS_PYTHON_SECTION=false
plan_python_section() {
  local path
  read_staged scripts ACDMRT
  ((${#STAGED[@]})) || return 0
  if ! command -v uv >/dev/null 2>&1; then
    for path in "${STAGED[@]}"; do
      case "$path" in
        *.py | scripts/pyproject.toml | scripts/uv.lock)
          require_command uv "$UV_INSTALL_HINT"
          ;;
        *) ;;
      esac
    done
    warn "uv not found: skipping the Python checks (no Python files are staged)"
    return 0
  fi
  HAS_PYTHON_SECTION=true
}

# Sets HAS_SHELL_SECTION when the hooks themselves, or their lint settings, are staged.
HAS_SHELL_SECTION=false
plan_shell_section() {
  local dir
  for dir in .githooks .shellcheckrc .editorconfig; do
    read_staged "$dir" ACDMRT
    if ((${#STAGED[@]})); then
      HAS_SHELL_SECTION=true
    fi
  done
}

# The checks themselves live in astro/scripts/verify.ts, shared with CI.
run_verify() {
  run_check "verify $1" astro npm run --silent verify -- "--$1"
}

main() {
  parse_hook_args 0 0 "$@"
  enter_repo
  [[ -d astro/node_modules ]] || die "astro/node_modules missing: run 'npm ci' in astro/"
  # Decided before anything is rewritten, so a missing uv stops the commit untouched.
  plan_python_section
  plan_shell_section

  autofix_app
  if [[ $HAS_PYTHON_SECTION == true ]]; then
    autofix_python
  fi
  run_verify app
  if [[ $HAS_PYTHON_SECTION == true ]]; then
    run_verify python
  fi
  if [[ $HAS_SHELL_SECTION == true ]]; then
    run_verify shell
  fi
  info "all checks passed"
}

main "$@"
