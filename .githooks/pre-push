#!/usr/bin/env bash
# pre-push: build the site and run the browser checks, then the global pre-push (Git LFS). Docs: .githooks/README.md.
set -euo pipefail

# shellcheck source=lib.sh
source "${BASH_SOURCE[0]%/*}/lib.sh"

usage() {
  cat <<USAGE
Usage: .githooks/pre-push [-h|--help] REMOTE_NAME REMOTE_URL

Run by git push, which sends the list of refs on stdin. Runs
"npm run verify -- --site" in astro/ (build and browser checks), then hands the arguments and stdin to the global pre-push hook (Git LFS).
Docs: .githooks/README.md.

Exit status: 0 passed, 1 a check failed, 2 usage error, 130 interrupted,
otherwise the global hook's.
USAGE
}

main() {
  parse_hook_args 2 2 "$@"
  enter_repo
  [[ -d astro/node_modules ]] || die "astro/node_modules missing: run 'npm ci' in astro/"
  run_check "verify site" astro npm run --silent verify -- --site
  info "all checks passed"
  run_global_hook "$@"
}

main "$@"
