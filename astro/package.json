{
  "name": "person-portfolio-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "css:build": "esbuild public/assets/css/styles.source.css --minify --outfile=public/assets/css/styles.css --log-level=warning",
    "css:watch": "esbuild public/assets/css/styles.source.css --minify --outfile=public/assets/css/styles.css --watch=forever --log-level=info",
    "prebuild": "npm run css:build",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "stats:refresh": "node scripts/refresh-stats-snapshots.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/stats-utils.test.mjs",
    "lint:css": "stylelint \"public/assets/css/styles.source.css\"",
    "format:check": "prettier --check \"src/data/**/*.json\"",
    "format": "prettier --write \"src/data/**/*.json\"",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "prepare": "git -C .. config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "astro": "^7.2.4",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright": "^1.62.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
