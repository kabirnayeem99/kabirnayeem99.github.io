{
  "name": "person-portfolio-astro",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/css.ts --dev --",
    "start": "node scripts/css.ts --dev --",
    "css:build": "node scripts/css.ts",
    "css:watch": "node scripts/css.ts --watch",
    "verify": "node scripts/verify.ts",
    "prebuild": "npm run css:build",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run css:build",
    "check": "astro check && tsc -p src/sw",
    "stats:refresh": "node scripts/refresh-stats-snapshots.ts",
    "lint": "eslint --max-warnings 0 .",
    "knip": "knip",
    "test": "node --test tests/stats-utils.test.ts \"tests/unit/*.test.ts\"",
    "lint:css": "stylelint \"src/styles/**/*.css\"",
    "format:check": "prettier --check \"src/data/**/*.json\"",
    "format": "prettier --write \"src/data/**/*.json\"",
    "test:smoke": "node --test tests/smoke.test.ts",
    "test:a11y": "node --test tests/browser/a11y.test.ts",
    "test:visual": "node --test tests/browser/geometry.test.ts tests/browser/visual.test.ts",
    "test:visual:update": "UPDATE_BASELINES=1 node --test tests/browser/visual.test.ts",
    "test:budgets": "node --test tests/browser/budgets.test.ts",
    "prepare": "git -C .. config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.0",
    "@eslint/js": "^10.0.1",
    "@material-symbols/svg-400": "^0.49.0",
    "@types/node": "^24.19.4",
    "@types/pngjs": "6.0.5",
    "astro": "^7.4.13",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "jiti": "2.7.0",
    "knip": "6.48.0",
    "pixelmatch": "8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "7.0.0",
    "prettier": "^3.10.1",
    "simple-icons": "^16.38.1",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended": "^19.1.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.74.0"
  }
}
