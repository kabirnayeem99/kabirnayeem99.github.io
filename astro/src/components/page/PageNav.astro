---
import type { IconName } from "../../lib/icons";
import type { MainNavItem, PageId } from "../../lib/main-nav";
import Icon from "./Icon.astro";

interface Props {
  readonly items: readonly MainNavItem[];
  readonly ariaLabel?: string;
}

const { items, ariaLabel = "Primary" } = Astro.props as Props;

const NAV_ICONS: Record<PageId, IconName> = {
  index: "home",
  reading: "menu_book",
  work: "work",
  project: "folder",
  blog: "edit",
  stats: "bar_chart",
};
---

<nav class="page-nav" aria-label={ariaLabel}>
  <div class="page-nav-track">
    {
      items.map((item) => (
        <a
          class="page-nav-link"
          href={item.href}
          aria-current={item.isCurrent ? "page" : undefined}
        >
          <Icon name={NAV_ICONS[item.pageId]} class="page-nav-icon" />
          <span class="page-nav-label">{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>
