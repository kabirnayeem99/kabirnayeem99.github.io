---
import type { MainNavItem, PageId } from "../../lib/main-nav";

interface Props {
  readonly items: readonly MainNavItem[];
  readonly ariaLabel?: string;
}

const { items, ariaLabel = "Primary" } = Astro.props as Props;

/* 24x24 stroke icons (Lucide-style), drawn in currentColor. */
const ICONS: Record<PageId, string> = {
  index: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M10 21v-6h4v6"/>',
  reading:
    '<path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/>',
  work: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M2 13h20"/>',
  project:
    '<path d="M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  blog: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>',
  stats: '<path d="M3 3v18h18"/><path d="M8 17v-5"/><path d="M13 17V8"/><path d="M18 17v-3"/>',
};
---

<nav class="page-nav" aria-label={ariaLabel}>
  <div class="page-nav-track">
    {
      items.map((item) => (
        <a
          class="page-nav-link"
          href={item.href}
          aria-current={item.isCurrent ? "page" : undefined}
        >
          <svg
            class="page-nav-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
            set:html={ICONS[item.pageId]}
          />
          <span class="page-nav-label">{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>
