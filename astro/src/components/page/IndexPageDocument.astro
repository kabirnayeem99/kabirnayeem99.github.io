---
import { Image } from "astro:assets";
import HandArrow from "./HandArrow.astro";
import BackToTopButton from "./BackToTopButton.astro";
import Botanical from "./Botanical.astro";
import BotanicalSprite from "./BotanicalSprite.astro";
import HeaderControls from "./HeaderControls.astro";
import HeadSeo from "./HeadSeo.astro";
import HighlightCard from "./HighlightCard.astro";
import PageFooter from "./PageFooter.astro";
import PageNav from "./PageNav.astro";
import { buildMainNav } from "../../lib/main-nav";
import heroLogo from "../../assets/images/logo.svg";
import profileQr from "../../assets/images/profile-qr.svg";
import featuredBooks from "../../data/site-content/featured-books.json";
import skillsData from "../../data/site-content/skills.json";
import goodreadsSnapshot from "../../data/site-content/goodreads-snapshot.json";
import { computeLegacyBuildTimestamp } from "../../lib/build-timestamp";
import {
  loadIndexPageContent,
  type IndexAction,
  type Lang,
  type PageId,
} from "../../lib/index-content";
import { LANGS } from "../../lib/locale-config";
import {
  buildOgImageUrl,
  buildPageAssetHrefs,
  PAGE_LAYOUT,
  UMAMI_WEBSITE_ID,
} from "../../lib/page-shared";
import {
  SOCIAL_CHIP_ICON_CLASS_BY_NAME,
  type SocialChipIconName,
  resolveSocialPlatformFromHref,
} from "../../lib/social-chip-icons";
import { buildSchemaGraphJson } from "../../lib/seo";
import {
  clippingMast,
  formatMarginDate,
  formatReadDate,
  MASTHEAD_KICKER,
  pinnedBotanical,
} from "../../lib/notebook";
import {
  assetHref,
  buildOgLocaleAlternates,
  OG_LOCALE_BY_LANG,
  routeHref,
} from "../../lib/work-project-content";

interface Props {
  readonly lang: Lang;
}

const { lang } = Astro.props as Props;
const content = loadIndexPageContent(lang);
const buildTimestamp = computeLegacyBuildTimestamp(lang);
const currentRoute = content.route;

const canonicalUrl =
  lang === "en"
    ? `${content.site.baseUrl}/`
    : `${content.site.baseUrl}/${content.route}`;
const ogImageUrl = buildOgImageUrl(content.site.baseUrl);
const schemaGraphJson = buildSchemaGraphJson({
  baseUrl: content.site.baseUrl,
  websiteName: content.site.websiteName,
  personName: content.site.personName,
  canonicalUrl,
  ogImageUrl,
  socialProfiles: content.site.socialProfiles,
  lang,
  pageTitle: content.meta.title,
  pageDescription: content.meta.description,
});

const alternateLinks = [
  ...LANGS.map((localeCode) => ({
    hrefLang: localeCode,
    href:
      localeCode === "en"
        ? `${content.site.baseUrl}/`
        : `${content.site.baseUrl}/${content.routes.index[localeCode]}`,
  })),
  { hrefLang: "x-default", href: `${content.site.baseUrl}/` },
] as const;

const ogLocaleAlternates = buildOgLocaleAlternates(lang);
const menuId = `language-menu-index-${lang}`;
const uiLabels = content.site.locale.labels;
const heroAvatarUi = {
  en: {
    showLabel: "Show profile QR code",
    hideLabel: "Show profile logo",
    hint: "Toggle the card to switch between the logo and the QR code.",
  },
  bn: {
    showLabel: "প্রোফাইল QR কোড দেখান",
    hideLabel: "প্রোফাইল লোগো দেখান",
    hint: "লোগো আর QR কোডের মধ্যে বদলাতে কার্ডটি টগল করুন।",
  },
  ar: {
    showLabel: "أظهر رمز QR للملف الشخصي",
    hideLabel: "أظهر الشعار الشخصي",
    hint: "بدّل البطاقة للتنقل بين الشعار ورمز QR.",
  },
  ur: {
    showLabel: "پروفائل QR کوڈ دکھائیں",
    hideLabel: "پروفائل لوگو دکھائیں",
    hint: "لوگو اور QR کوڈ کے درمیان بدلنے کے لیے کارڈ ٹوگل کریں۔",
  },
}[lang];

const pageAssets = buildPageAssetHrefs(currentRoute);
const darkModeIconHref = assetHref(currentRoute, "icons/theme-dark.svg");
const lightModeIconHref = assetHref(currentRoute, "icons/theme-light.svg");
const goodreadsScriptSource = (() => {
  try {
    const parsed = new URL(content.statsCompact.goodreads.scriptSrc);
    parsed.searchParams.set("num_books", "11");
    return parsed.toString();
  } catch {
    return content.statsCompact.goodreads.scriptSrc;
  }
})();

function routeForAction(pageId: PageId): string {
  return content.routes[pageId][lang];
}

interface ResolvedAction {
  readonly href: string;
  readonly navPageId?: PageId;
  readonly isExternal: boolean;
  readonly isMailto: boolean;
  readonly variantClass: string;
  readonly labelText: string;
  readonly showTrailingArrow: boolean;
}

function stripMailPrefix(label: string): string {
  return label.replace(/^✉\s*/, "");
}

function resolveAction(action: IndexAction): ResolvedAction {
  let href = action.href;
  let navPageId: PageId | undefined;
  if (action.pageId !== undefined) {
    href = routeHref(currentRoute, routeForAction(action.pageId));
    navPageId = action.pageId;
  }
  if (href === undefined) {
    throw new Error("Index action missing href and pageId");
  }

  const isExternal = href.startsWith("http://") || href.startsWith("https://");
  const isMailto = href.startsWith("mailto:");
  const isPageLink = navPageId !== undefined;

  let variantClass =
    action.variant === "primary"
      ? "action-chip action-chip--primary"
      : "action-chip action-chip--secondary";
  if (isPageLink && action.variant === "secondary") {
    variantClass = `${variantClass} action-chip--compact-nav`;
  }

  const resolved: {
    href: string;
    isExternal: boolean;
    isMailto: boolean;
    variantClass: string;
    labelText: string;
    showTrailingArrow: boolean;
    navPageId?: PageId;
  } = {
    href,
    isExternal,
    isMailto,
    variantClass,
    labelText: isMailto ? stripMailPrefix(action.label) : action.label,
    showTrailingArrow: isPageLink && action.variant === "secondary",
  };
  if (navPageId !== undefined) {
    resolved.navPageId = navPageId;
  }
  return resolved;
}

interface SocialChip {
  readonly href: string;
  readonly ariaLabel: string;
  readonly text: string;
  readonly iconName: SocialChipIconName;
  readonly isExternal: boolean;
}

function toSocialChip(action: IndexAction): SocialChip {
  const resolved = resolveAction(action);
  if (resolved.navPageId !== undefined) {
    throw new Error("Top social actions cannot be page links");
  }
  if (!resolved.isMailto) {
    throw new Error("Top social actions must use a mailto href");
  }

  return {
    href: resolved.href,
    ariaLabel: resolved.labelText,
    text: resolved.labelText,
    iconName: "email",
    isExternal: false,
  };
}

const topSocialChips = content.topActions.map((action) => toSocialChip(action));
const profileSocialChips = content.site.socialProfiles.map((href) => {
  const platform = resolveSocialPlatformFromHref(href);
  const label = content.site.locale.socialPlatformLabels[platform];
  return {
    href,
    ariaLabel: label,
    text: label,
    iconName: platform,
    isExternal: true,
  } as const;
});
const socialChips: readonly SocialChip[] = [
  ...topSocialChips,
  ...profileSocialChips,
];
// The home shelf opens with the last book read (the snapshot's newest; goodreads-loader
// swaps in a newer one from cache or live Goodreads), then hand-picked covers
// (featured-books.json lists their file names); the stats page holds the full wall.
// Picks missing from the snapshot are skipped; with none left, recent reads fill in.
const SHELF_PICKS = 8;
const lastReadBook = goodreadsSnapshot.books[0];
const snapshotByFile = new Map(goodreadsSnapshot.books.map((book) => [book.imageFileName, book]));
const readTime = (book: (typeof goodreadsSnapshot.books)[number]): number =>
  Date.parse((book as { dateRead?: string }).dateRead ?? "") || 0;
const pickedBooks = featuredBooks.books
  .flatMap((fileName) => snapshotByFile.get(fileName) ?? [])
  .filter((book) => book !== lastReadBook)
  .sort((a, b) => readTime(b) - readTime(a))
  .slice(0, SHELF_PICKS);
const shelfPicks = pickedBooks.length > 0 ? pickedBooks : goodreadsSnapshot.books.slice(1, 1 + SHELF_PICKS);
const toShelfBook = (book: (typeof goodreadsSnapshot.books)[number]) => ({
  ...book,
  readDate: formatReadDate((book as { dateRead?: string }).dateRead, lang),
});
const lastReadShelfBook = lastReadBook ? toShelfBook(lastReadBook) : undefined;
const goodreadsBooks = shelfPicks.map(toShelfBook);
// Review ids already in the snapshot: a live "newest" book outside this set is a genuine
// new read; one inside it is just Goodreads' unreliable widget order (see goodreads-loader).
const knownReviewIds = goodreadsSnapshot.books.flatMap((book) => /\/review\/show\/(\d+)/.exec(book.href)?.[1] ?? []);
const LAST_READ_LABEL: Readonly<Record<Lang, string>> = {
  en: "Last read",
  bn: "সবশেষ পড়া",
  ar: "آخِرُ مَا قَرَأْتُ",
  ur: "آخری پڑھی",
};
const marginDate = formatMarginDate(buildTimestamp.iso, lang);

// Last slot on the home shelf: a cover-sized library card linking to the full list.
const SHELF_MORE_LABEL: Readonly<Record<Lang, string>> = {
  en: "Show all read books",
  bn: "পড়া সব বই দেখুন",
  ar: "عَرْضُ كُلِّ ٱلْكُتُبِ ٱلْمَقْرُوءَةِ",
  ur: "پڑھی ہوئی تمام کتابیں دیکھیں",
};
const SHELF_MORE_COUNT: Readonly<Record<Lang, (count: string) => string>> = {
  en: (count) => `+${count} more`,
  bn: (count) => `আরও ${count}টি`,
  ar: (count) => `+${count} أُخْرَى`,
  ur: (count) => `مزید ${count}`,
};
const NUMBER_LOCALE: Readonly<Record<Lang, string>> = { en: "en-GB", bn: "bn-BD", ar: "ar-EG", ur: "ur-PK" };
// The stats page lists at most 300 books.
const remainingBooks = Math.max(0, Math.min(goodreadsSnapshot.books.length, 300) - goodreadsBooks.length);
const shelfMoreCount = SHELF_MORE_COUNT[lang](new Intl.NumberFormat(NUMBER_LOCALE[lang]).format(remainingBooks));
const statsBooksHref = `${routeHref(currentRoute, routeForAction("stats"))}#gr_grid_widget_${content.statsCompact.goodreads.widgetId}`;

const viewAllStatsAction: IndexAction = {
  label: content.viewAllStatsLabel,
  pageId: "stats",
  variant: "secondary",
};

// Skills sit on a sticker sheet: one row of die-cut stickers per group (skills.json).
// Brand names stay as written in every locale; spoken languages carry their own script.
const skillGroups = skillsData.groups.map((group) => ({
  label: group.label[lang],
  items: group.items.map((item) => {
    const extra = item as { icon?: string; lang?: string; note?: Readonly<Record<Lang, string>> };
    return {
      name: item.name,
      iconHref: extra.icon ? assetHref(currentRoute, `assets/icons/skills/${extra.icon}.svg`) : undefined,
      lang: extra.lang,
      note: extra.note?.[lang],
    };
  }),
}));

const visibleSections = content.sections.filter((section) => section.tags.length === 0);
const [leadSection, ...remainingSections] = visibleSections;

function buildSectionClassName(
  section: (typeof visibleSections)[number],
  role: "lead" | "default" = "default",
): string {
  const classNames = ["index-section"];
  if (role === "lead") {
    classNames.push("index-section--lead");
  }
  if (section.highlights.length > 0) {
    classNames.push("index-section--showcase");
  }
  if (section.articles.length > 0) {
    classNames.push("index-section--editorial");
  }
  if (
    section.highlights.length === 0 &&
    section.articles.length === 0 &&
    section.paragraphs.length > 0
  ) {
    classNames.push("index-section--notes");
  }
  return classNames.join(" ");
}
---

<!doctype html>
<html lang={lang} dir={content.site.locale.dir}>
  <HeadSeo
    lang={lang}
    title={content.meta.title}
    description={content.meta.description}
    keywords={content.meta.keywords}
    author={content.site.locale.author}
    canonicalUrl={canonicalUrl}
    alternateLinks={alternateLinks}
    ogType="website"
    ogLocale={OG_LOCALE_BY_LANG[lang]}
    ogLocaleAlternates={ogLocaleAlternates}
    ogImageUrl={ogImageUrl}
    ogImageAlt={content.site.locale.ogImageAlt}
    twitterSite={content.site.twitterSite}
    schemaGraphJson={schemaGraphJson}
    googleSiteVerification={content.site.googleSiteVerification}
    umamiWebsiteId={UMAMI_WEBSITE_ID}
    stylesheetHref={pageAssets.stylesheetHref}
    faviconSvgHref={pageAssets.faviconSvgHref}
    favicon32Href={pageAssets.favicon32Href}
    favicon16Href={pageAssets.favicon16Href}
    faviconIcoHref={pageAssets.faviconIcoHref}
    appleTouchIconHref={pageAssets.appleTouchIconHref}
    manifestHref={pageAssets.manifestHref}
  />
  <body
    data-page-id="index"
    data-sw-path={pageAssets.swPath}
    data-goodreads-script-src={goodreadsScriptSource}
  >
    <BotanicalSprite />
    <a class={PAGE_LAYOUT.skipLinkClass} href={`#${PAGE_LAYOUT.mainContentId}`}>
      {uiLabels.skipToMain}
    </a>
    <div class={PAGE_LAYOUT.siteClass}>
      <header id="top">
        <Botanical name="euc" class="pf pf--head" />
        <div class="masthead">
          <div class="header-identity-copy">
            <p class="masthead-kicker">{MASTHEAD_KICKER[lang]}</p>
            <h1 class="site-title">{content.header.siteTitle}</h1>
            <p class="tagline">{content.header.tagline}</p>
          </div>
          <HeaderControls
            currentRoute={currentRoute}
            darkModeIconHref={darkModeIconHref}
            lang={lang}
            languageLinks={content.routes.index}
            languageMenuId={menuId}
            languageMenuLabels={content.site.languageMenuLabels}
            languageSwitcherLabel={content.site.locale.languageSwitcherLabel}
            lightModeIconHref={lightModeIconHref}
            themeDarkLabel={uiLabels.themeDark}
            themeLightLabel={uiLabels.themeLight}
          />
        </div>
        <PageNav items={buildMainNav(currentRoute)} />
      </header>

      <main id={PAGE_LAYOUT.mainContentId}>
        <div class="intro-stage">
          <section class="about-section intro-stage-primary">
            <div class="summary-card summary-card--about">
              {content.summaryCard.map((paragraph) => <p set:html={paragraph} />)}
            </div>
            {topSocialChips.length > 0 ? <HandArrow variant="curl" class="hand-arrow--to-contact" /> : null}
            <div class="social-chip-row" aria-label={content.socialRowLabel}>
              {
                socialChips.map((chip) => (
                  <a
                    class="social-chip"
                    href={chip.href}
                    target={chip.isExternal ? "_blank" : undefined}
                    rel={chip.isExternal ? "noreferrer" : undefined}
                    aria-label={chip.ariaLabel}
                    data-umami-track-social="true"
                    data-social-platform={chip.iconName}
                  >
                    <span
                      class={`social-chip-icon ${SOCIAL_CHIP_ICON_CLASS_BY_NAME[chip.iconName]}`}
                      aria-hidden="true"
                    />
                    <span>{chip.text}</span>
                  </a>
                ))
              }
            </div>
          </section>

          <div class="intro-stage-figure">
            <Botanical name="shapla" class="pf pf--sleeve-lily" />
            <Botanical name="cosmos-head" class="pf pf--sleeve-cosmos" />
            <button
              class="hero-avatar-toggle"
              type="button"
              aria-expanded="false"
              aria-label={heroAvatarUi.showLabel}
              title={heroAvatarUi.showLabel}
              data-hero-avatar-toggle
              data-label-show={heroAvatarUi.showLabel}
              data-label-hide={heroAvatarUi.hideLabel}
            >
              <span class="visually-hidden">{heroAvatarUi.hint}</span>
              <span class="hero-avatar-card" data-paper-flutter>
                <span class="peel-flap" aria-hidden="true"></span>
                <span class="hero-avatar-flip">
                  <span class="hero-avatar-face hero-avatar-face--front">
                    <Image
                      class="hero-illustration"
                      alt={content.site.locale.ogImageAlt}
                      src={heroLogo}
                      width={1024}
                      height={1024}
                      loading="eager"
                      decoding="async"
                      fetchpriority="high"
                    />
                  </span>
                  <span class="hero-avatar-face hero-avatar-face--back" aria-hidden="true">
                    <Image
                      class="hero-qr-code"
                      alt=""
                      src={profileQr}
                      width={512}
                      height={512}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                </span>
              </span>
            </button>
          </div>
        </div>

        {
          leadSection ? (
            <section class={buildSectionClassName(leadSection, "lead")}>
              <div class="section-head">
                <h2 class="section-title">{leadSection.title}</h2>
              </div>
              <Botanical name="sprig" class="sprig" />
              <div class="entry">
                <span class="margin-note" aria-hidden="true">{marginDate}</span>
                {leadSection.images.length > 0 ? (
                  <div class="now-prints">
                    {leadSection.images.map((image) => (
                      <figure class={image.width > image.height * 1.3 ? "print now-print now-print--wide" : "print now-print"}>
                        <img
                          src={assetHref(currentRoute, image.src)}
                          alt={image.alt}
                          width={image.width}
                          height={image.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </figure>
                    ))}
                  </div>
                ) : null}
                {leadSection.paragraphs.map((paragraph) => (
                  <p set:html={paragraph} />
                ))}
                {leadSection.contacts.map((contact) => (
                  <p>{contact}</p>
                ))}
              </div>
              {leadSection.actions.length > 0 ? (
                <div class="section-actions">
                  {leadSection.actions.map((action) => {
                    const resolved = resolveAction(action);
                    return (
                      <a
                        class={resolved.variantClass}
                        href={resolved.href}
                        target={resolved.isExternal ? "_blank" : undefined}
                        rel={resolved.isExternal ? "noreferrer" : undefined}
                        data-nav-page-id={resolved.navPageId}
                      >
                        <span>{resolved.labelText}</span>
                        {resolved.showTrailingArrow ? (
                          <span class="action-chip-arrow" aria-hidden="true" />
                        ) : null}
                      </a>
                    );
                  })}
                </div>
              ) : null}
              <Botanical name="poppy" class="pf pf--start pf--tall pf--tilt-r" style="inset-block-end: -120px" />
            </section>
          ) : null
        }

        {
          remainingSections.map((section, sectionIndex) => (
            <section class={buildSectionClassName(section)}>
              {sectionIndex % 2 === 0 ? (
                <Botanical name="cosmos" class="pf pf--end pf--tall-wide pf--tilt-r" />
              ) : (
                <Botanical name="buds" class="pf pf--end pf--tall-wide pf--tilt-l" />
              )}
              <div class="section-head">
                <h2 class="section-title">{section.title}</h2>
              </div>
              <Botanical name="sprig" class="sprig" />
              {section.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {section.highlights.length > 0 ? (
                <div class="highlight-list">
                  {section.highlights.map((highlight, highlightIndex) => (
                    <HighlightCard card={highlight} botanical={pinnedBotanical(highlightIndex)} />
                  ))}
                </div>
              ) : null}
              {section.articles.length > 0 ? (
                <ul class="article-list">
                  {section.articles.map((article) => {
                    const mast = clippingMast(article.href);
                    return (
                      <li class="article-item">
                        <a
                          href={article.href}
                          target="_blank"
                          rel="noreferrer"
                          data-umami-track-article="true"
                        >
                          <span class="clipping-mast" aria-hidden="true">
                            <b>{mast.publication}</b>
                          </span>
                          <h3>{article.title}</h3>
                          <p>{article.summary}</p>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              ) : null}
              {section.contacts.map((contact) => (
                <p>{contact}</p>
              ))}
              {section.actions.length > 0 ? (
                <div class="section-actions">
                  {section.actions.map((action) => {
                    const resolved = resolveAction(action);
                    return (
                      <a
                        class={resolved.variantClass}
                        href={resolved.href}
                        target={resolved.isExternal ? "_blank" : undefined}
                        rel={resolved.isExternal ? "noreferrer" : undefined}
                        data-nav-page-id={resolved.navPageId}
                      >
                        {resolved.isMailto ? (
                          <span class="action-chip-icon action-chip-icon--mail" aria-hidden="true" />
                        ) : null}
                        <span>{resolved.labelText}</span>
                        {resolved.showTrailingArrow ? (
                          <span class="action-chip-arrow" aria-hidden="true" />
                        ) : null}
                      </a>
                    );
                  })}
                </div>
              ) : null}
            </section>
          ))
        }

        <section class="index-section index-section--stats" data-umami-track-view="wakatime-stats">
          <Botanical name="cosmos-head" class="pf pf--start pf--head-small pf--tilt-r" />
          <div class="section-head">
            <h2 class="section-title">{content.statsCompact.wakatime.title}</h2>
          </div>
          <Botanical name="sprig" class="sprig" />
          <div class="sticker-sheet taped">
            {skillGroups.map((group) => (
              <div class="sticker-group">
                <h3 class="sticker-group-label">{group.label}</h3>
                <ul class="sticker-row">
                  {group.items.map((item) => (
                    <li class="skill-sticker" data-spoken={item.lang ? "" : undefined}>
                      {item.iconHref ? (
                        <img src={item.iconHref} alt="" width="18" height="18" loading="lazy" decoding="async" />
                      ) : null}
                      <span lang={item.lang} dir={item.lang ? "auto" : undefined}>{item.name}</span>
                      {item.note ? <small class="skill-sticker-note">{item.note}</small> : null}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <div class="section-actions">
            {
              (() => {
                const resolved = resolveAction(viewAllStatsAction);
                return (
                  <a
                    class={resolved.variantClass}
                    href={resolved.href}
                    data-nav-page-id={resolved.navPageId}
                    data-nav-source="wakatime"
                  >
                    <span>{resolved.labelText}</span>
                    <span class="action-chip-arrow" aria-hidden="true" />
                  </a>
                );
              })()
            }
          </div>
        </section>

        <section class="index-section index-section--books books-shelf-section" data-umami-track-view="books">
          <Botanical name="fern" class="pf pf--end pf--fern pf--tilt-l" />
          <Botanical name="wheat" class="pf pf--start pf--slim" style="inset-block-start: 40%" />
          <div class="section-head">
            <h2 class="section-title">{content.statsCompact.goodreads.title}</h2>
          </div>
          <Botanical name="sprig" class="sprig" />
          <p>{content.statsCompact.goodreads.copy}</p>
          <script type="application/json" id="goodreads-known-reviews" is:inline set:html={JSON.stringify(knownReviewIds)} />
          <div
            class="goodreads-widget"
            id={`gr_grid_widget_${content.statsCompact.goodreads.widgetId}`}
            data-stats-books-href={statsBooksHref}
          >
            <div class="gr_grid_container">
              {lastReadShelfBook ? (
                <div class="gr_grid_book_container gr_grid_book_container--last-read" data-last-read>
                  <span class="book-strip book-strip--last-read">{LAST_READ_LABEL[lang]}</span>
                  <span class="book-strip book-strip--date" dir="auto" hidden={!lastReadShelfBook.readDate}>
                    {lastReadShelfBook.readDate}
                  </span>
                  <a
                    title={lastReadShelfBook.title}
                    rel="nofollow noreferrer"
                    href={lastReadShelfBook.href}
                    target="_blank"
                    data-umami-track-book="true"
                    data-cursor-plain
                  >
                    <img
                      alt={lastReadShelfBook.alt}
                      src={assetHref(currentRoute, lastReadShelfBook.imageLocal.replace(/^\/+/, ""))}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <span class="book-strip book-strip--title" dir="auto">{lastReadShelfBook.title}</span>
                </div>
              ) : null}
              {
                goodreadsBooks.map((book) => (
                  <div class="gr_grid_book_container">
                    {book.readDate ? (
                      <span class="book-strip book-strip--date" dir="auto">{book.readDate}</span>
                    ) : null}
                    <a
                      title={book.title}
                      rel="nofollow noreferrer"
                      href={book.href}
                      target="_blank"
                      data-umami-track-book="true"
                      data-cursor-plain
                    >
                      <img
                        alt={book.alt}
                        src={assetHref(currentRoute, book.imageLocal.replace(/^\/+/, ""))}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                    <span class="book-strip book-strip--title" dir="auto">{book.title}</span>
                  </div>
                ))
              }
              <div class="gr_grid_book_placeholder">
                <span class="book-strip book-strip--date book-strip--blank" aria-hidden="true"></span>
                <a
                  class="shelf-more-card"
                  href={statsBooksHref}
                  data-umami-track-book="true"
                  data-cursor-plain
                >
                  <span class="shelf-more-label">{SHELF_MORE_LABEL[lang]}</span>
                  <span class="action-chip-arrow" aria-hidden="true"></span>
                  <span class="shelf-more-pocket" aria-hidden="true"><span>{shelfMoreCount}</span></span>
                </a>
              </div>
            </div>
          </div>
        </section>
      </main>

      <PageFooter
        signature={content.site.locale.author}
        footerHtml={content.footerHtml}
        lastUpdatedLabel={uiLabels.lastUpdated}
        timestampIso={buildTimestamp.iso}
        timestampDisplay={buildTimestamp.display}
      />
      <svg class="pressed pf pf--bouquet" viewBox="0 0 220 200" aria-hidden="true" focusable="false">
        <use href="#bot-wheat" x="20" y="0" width="40" height="200" />
        <use href="#bot-cosmos" x="50" y="10" width="70" height="190" />
        <use href="#bot-euc" x="100" y="20" width="90" height="180" />
        <use href="#bot-dandelion" x="160" y="30" width="50" height="170" />
      </svg>
    </div>

    <BackToTopButton label={uiLabels.backToTop} />
    <script>
      import "../../scripts/entries/index-page";
    </script>
  </body>
</html>
