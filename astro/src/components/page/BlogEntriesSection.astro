---
import { hasText } from "../../scripts/modules/guards";
import { clippingMast } from "../../lib/notebook";
import Icon from "./Icon.astro";

interface BlogArticle {
  readonly title: string;
  readonly href: string;
  readonly meta?: string;
  readonly summary: string;
}

interface Props {
  readonly articles: readonly BlogArticle[];
}

const { articles } = Astro.props;
---

<section>
  <ul class="article-list">
    {
      articles.map((article) => {
        const mast = clippingMast(article.href, article.meta);
        return (
          <li class="article-item">
            <a
              href={article.href}
              target="_blank"
              rel="noreferrer"
              data-umami-track-article="true"
            >
              <Icon name="article" class="article-icon" />
              <span class="clipping-mast" aria-hidden="true">
                <b>{mast.publication}</b>
                {hasText(mast.topic) ? <span>{mast.topic}</span> : null}
              </span>
              <h2>{article.title}</h2>
              <p>{article.summary}</p>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>
