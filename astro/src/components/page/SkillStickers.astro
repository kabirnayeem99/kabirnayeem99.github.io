---
import { hasText } from "../../scripts/modules/guards";
import skillsData from "../../data/site-content/skills.json";
import type { Lang } from "../../lib/locale-config";
import { toIconName } from "../../lib/icons";
import Icon from "./Icon.astro";

interface Props {
  readonly lang: Lang;
  readonly title: string;
}

const { lang, title } = Astro.props;

// Skills sit on a sticker sheet: one row of die-cut stickers per group (skills.json).
// Brand names stay as written in every locale; spoken languages carry their own script.
const skillGroups = skillsData.groups.map((group) => ({
  label: group.label[lang],
  items: group.items.map((item) => {
    const extra: { name: string; icon?: string; lang?: string; note?: Readonly<Record<Lang, string>> } = item;
    return {
      name: item.name,
      icon: hasText(extra.icon) ? toIconName(extra.icon, `skills.json ${item.name}`) : undefined,
      lang: extra.lang,
      note: extra.note?.[lang],
    };
  }),
}));
---

<section class="index-section index-section--stats">
  <div class="section-head">
    <h2 class="section-title">{title}</h2>
  </div>
  <div class="sticker-sheet taped">
    {skillGroups.map((group) => (
      <div class="sticker-group">
        <h3 class="sticker-group-label">{group.label}</h3>
        <ul class="sticker-row">
          {group.items.map((item) => (
            <li class="skill-sticker" data-spoken={hasText(item.lang) ? "" : undefined}>
              {item.icon !== undefined ? <Icon name={item.icon} /> : null}
              <span lang={item.lang} dir={hasText(item.lang) ? "auto" : undefined}>{item.name}</span>
              {hasText(item.note) ? <small class="skill-sticker-note">{item.note}</small> : null}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <slot />
</section>
