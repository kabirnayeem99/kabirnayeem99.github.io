---
import { hasText } from "../../scripts/modules/guards";
import { assetHref, type CardImage, type ContentCard, type PictureCredit } from "../../lib/work-project-content";
import HandArrow from "./HandArrow.astro";
import JournalEntry from "./JournalEntry.astro";

interface Props {
  readonly summary: string;
  readonly sectionTitle: string;
  readonly entries: readonly ContentCard[];
  readonly heroImages: readonly CardImage[];
  readonly tagsLabel: string;
  readonly projectsLink: { readonly href: string; readonly label: string };
  readonly creditsTitle: string;
  readonly pictureCredits: readonly PictureCredit[];
}

const { summary, sectionTitle, entries, heroImages, tagsLabel, projectsLink, creditsTitle, pictureCredits } =
  Astro.props;
const requestedRoute = Astro.url.pathname.replace(/^\/+/, "");
const currentRoute = requestedRoute === "" ? "index.html" : requestedRoute;
---

<section class="page-intro work-intro">
  <div class="summary-card">
    <p set:html={summary} />
  </div>
  <p class="work-projects-link">
    <a class="action-chip" href={projectsLink.href} data-nav-page-id="project">
      <span>{projectsLink.label}</span>
      <span class="action-chip-arrow" aria-hidden="true"></span>
    </a>
  </p>
  {
    heroImages.length > 0 ? (
      <div class="postcards">
        {heroImages.map((image, index) => (
          <figure class="print postcard" style={`--ar:${(image.width / image.height).toFixed(3)}`}>
            <img
              src={assetHref(currentRoute, image.src)}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
            />
            {hasText(image.caption) ? <figcaption>{image.caption}</figcaption> : null}
          </figure>
        ))}
      </div>
    ) : null
  }
</section>
<section>
  <div class="section-head">
    <h2 class="section-title">{sectionTitle}</h2>
    <HandArrow variant="curl" class="hand-arrow--title" />
  </div>
  <ol class="journal">
    {entries.map((entry) => <JournalEntry entry={entry} tagsLabel={tagsLabel} />)}
  </ol>
  <p class="work-projects-link work-projects-link--after">
    <a class="action-chip" href={projectsLink.href} data-nav-page-id="project">
      <span>{projectsLink.label}</span>
      <span class="action-chip-arrow" aria-hidden="true"></span>
    </a>
  </p>
</section>
{
  pictureCredits.length > 0 ? (
    <section class="picture-credits">
      <h2>{creditsTitle}</h2>
      <ul>
        {pictureCredits.map((credit) => (
          <li>
            <a href={credit.source} target="_blank" rel="noreferrer">{credit.name}</a>, {credit.author},{" "}
            <a href={credit.licenseUrl} target="_blank" rel="noreferrer">{credit.license}</a>
          </li>
        ))}
      </ul>
    </section>
  ) : null
}
