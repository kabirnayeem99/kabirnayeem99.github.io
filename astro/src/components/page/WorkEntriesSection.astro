---
import type { ContentCard } from "../../lib/work-project-content";
import HandArrow from "./HandArrow.astro";
import Botanical from "./Botanical.astro";
import HighlightCard from "./HighlightCard.astro";

interface Props {
  readonly summary: string;
  readonly sectionTitle: string;
  readonly entries: readonly ContentCard[];
}

const { summary, sectionTitle, entries } = Astro.props;
---

<section class="page-intro">
  <div class="summary-card">
    <p set:html={summary} />
  </div>
</section>
<section>
  <Botanical name="cosmos-nod" class="pf pf--start pf--tall pf--tilt-l" />
  <Botanical name="buds" class="pf pf--end pf--tall-wide pf--tilt-r" />
  <div class="section-head">
    <h2 class="section-title">{sectionTitle}</h2>
    <HandArrow variant="curl" class="hand-arrow--title" />
  </div>
  <Botanical name="sprig" class="sprig" />
  <div class="highlight-list">
    {entries.map((entry) => <HighlightCard card={entry} />)}
  </div>
</section>
