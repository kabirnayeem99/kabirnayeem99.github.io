---
import { THEME_BOOTSTRAP_SCRIPT } from "../../lib/page-labels";
import {
  resolveCanonicalHostname,
  shouldLoadUmamiScript,
} from "../../lib/runtime-host-gating";
import {
  AGENT_DISCOVERY_LINKS,
  type AgentDiscoveryLink,
} from "../../lib/agent-discovery";
import type { Lang } from "../../lib/locale-config";

interface AlternateLink {
  readonly hrefLang: string;
  readonly href: string;
}

interface Props {
  readonly title: string;
  readonly description: string;
  readonly keywords: string;
  readonly author: string;
  readonly canonicalUrl: string;
  readonly alternateLinks: readonly AlternateLink[];
  readonly ogType: "website" | "article";
  readonly ogLocale: string;
  readonly ogLocaleAlternates: readonly string[];
  readonly ogImageUrl: string;
  readonly ogImageAlt: string;
  readonly twitterSite: string;
  readonly schemaGraphJson: string;
  readonly googleSiteVerification: string;
  readonly umamiWebsiteId: string;
  readonly stylesheetHref?: string;
  readonly faviconSvgHref?: string;
  readonly favicon32Href?: string;
  readonly favicon16Href?: string;
  readonly faviconIcoHref?: string;
  readonly appleTouchIconHref?: string;
  readonly manifestHref?: string;
  readonly discoveryLinks?: readonly AgentDiscoveryLink[];
  readonly preconnectHrefs?: readonly string[];
  readonly robots?: string;
  readonly lang?: Lang;
}

const {
  title,
  description,
  keywords,
  author,
  canonicalUrl,
  alternateLinks,
  ogType,
  ogLocale,
  ogLocaleAlternates,
  ogImageUrl,
  ogImageAlt,
  twitterSite,
  schemaGraphJson,
  googleSiteVerification,
  umamiWebsiteId,
  stylesheetHref = "assets/css/styles.css",
  faviconSvgHref = "/assets/icons/favicon.svg",
  favicon32Href = "assets/icons/favicon-32x32.png",
  favicon16Href = "assets/icons/favicon-16x16.png",
  faviconIcoHref = "assets/icons/favicon.ico",
  appleTouchIconHref = "assets/icons/apple-touch-icon.png",
  manifestHref = "site.webmanifest",
  discoveryLinks = AGENT_DISCOVERY_LINKS,
  preconnectHrefs = [] as readonly string[],
  robots = "index, follow",
  lang = "en",
} = Astro.props;

const canonicalHostname = resolveCanonicalHostname(canonicalUrl);
const shouldLoadUmami = shouldLoadUmamiScript(
  import.meta.env.PROD,
  umamiWebsiteId,
  canonicalHostname,
);
const resolvedPreconnectHrefs = shouldLoadUmami
  ? [...new Set([...preconnectHrefs, "https://cloud.umami.is"])]
  : preconnectHrefs;
const feedHref = (() => {
  try {
    return `${new URL(canonicalUrl).origin}/feed.xml`;
  } catch {
    return undefined;
  }
})();

// Each page preloads only the face its own language is set in; other scripts load on demand.
const PRIMARY_FONT_BY_LANG: Readonly<Record<Lang, string>> = {
  en: "/assets/fonts/newsreader_latin_normal_200-800.woff2",
  bn: "/assets/fonts/tiro-bangla_bengali_normal_400.woff2",
  ar: "/assets/fonts/amiri_arabic_normal_400.woff2",
  ur: "/assets/fonts/gulzar_arabic_normal_400.woff2",
};

// Instant page changes, app-style, from plain static HTML (works on GitHub Pages: no headers
// needed). Internal links are fetched as they come into view and fully prerendered on hover,
// so the click only swaps the page. Stats is fetched but never prerendered: prerendering
// would spend the GitHub / WakaTime API limits on a hover.
const INTERNAL_LINKS = {
  and: [
    { href_matches: "/*" },
    { not: { selector_matches: "[target=_blank], [download], [rel~=nofollow]" } },
    { not: { href_matches: ["/*.xml", "/*.txt", "/*.md", "/*.json"] } },
  ],
};
const SPECULATION_RULES = JSON.stringify({
  prefetch: [{ where: INTERNAL_LINKS, eagerness: "eager" }],
  prerender: [
    {
      where: { and: [INTERNAL_LINKS, { not: { href_matches: ["/stats.html", "/*/stats.html"] } }] },
      eagerness: "moderate",
    },
  ],
});

// On arrival through a page transition: re-read the theme (a page prerendered before a
// theme toggle would show the old one) and skip the header's entrance animation, which
// would replay on top of the transition's own.
const PAGE_ARRIVAL_SCRIPT =
  "(function(){var r=document.documentElement;addEventListener('pagereveal',function(e){" +
  "try{var t=localStorage.getItem('person-portfolio-theme');if(t==='light'||t==='dark'){r.setAttribute('data-theme',t);}}catch(_e){}" +
  "if(e.viewTransition){r.classList.add('vt-arrived');}});})();";

// Umami loads only once the page is really shown: a prerendered page someone hovered but
// never opened must not count as a visit.
function buildUmamiLoader(websiteId: string, domains: string | null | undefined): string {
  const config = JSON.stringify({ websiteId, domains: domains ?? "" });
  return `(function(c){function load(){var s=document.createElement("script");s.src="https://cloud.umami.is/script.js";s.defer=true;s.dataset.websiteId=c.websiteId;if(c.domains)s.dataset.domains=c.domains;document.head.appendChild(s);}if(document.prerendering){document.addEventListener("prerenderingchange",load,{once:true});}else{load();}})(${config});`;
}
---

<head>
  {resolvedPreconnectHrefs.map((href) => <link rel="preconnect" href={href} crossorigin />)}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content={author} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonicalUrl} />
  {feedHref && <link rel="alternate" type="application/rss+xml" title="Blog — Naimul Kabir" href={feedHref} />}
  {
    discoveryLinks.map((link) => (
      <link rel={link.rel} href={link.href} type={link.type} title={link.title} />
    ))
  }
  <meta name="person-portfolio-site-hostname" content={canonicalHostname ?? ""} />
  {
    alternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hrefLang} href={link.href} />
    ))
  }
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={author} />
  <meta property="og:locale" content={ogLocale} />
  {
    ogLocaleAlternates.map((alternateLocale) => (
      <meta property="og:locale:alternate" content={alternateLocale} />
    ))
  }
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={twitterSite} />
  <meta name="twitter:creator" content={twitterSite} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta
    name="theme-color"
    content="#faf8f3"
    media="(prefers-color-scheme: light)"
  />
  <meta
    name="theme-color"
    content="#12100d"
    media="(prefers-color-scheme: dark)"
  />
  <meta name="color-scheme" content="light dark" />
  <script is:inline type="application/ld+json" set:html={schemaGraphJson} />
  {
    shouldLoadUmami ? (
      <script is:inline set:html={buildUmamiLoader(umamiWebsiteId, canonicalHostname)} />
    ) : null
  }
  <script is:inline set:html={THEME_BOOTSTRAP_SCRIPT} />
  <script is:inline set:html={PAGE_ARRIVAL_SCRIPT} />
  <script is:inline type="speculationrules" set:html={SPECULATION_RULES} />
  <link
    rel="preload"
    href={PRIMARY_FONT_BY_LANG[lang]}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <link rel="preload" href={stylesheetHref} as="style" />
  <link rel="stylesheet" href={stylesheetHref} />
  <link rel="icon" type="image/svg+xml" href={faviconSvgHref} />
  <link rel="icon" type="image/png" sizes="32x32" href={favicon32Href} />
  <link rel="icon" type="image/png" sizes="16x16" href={favicon16Href} />
  <link rel="shortcut icon" href={faviconIcoHref} />
  <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconHref} />
  <link rel="manifest" href={manifestHref} />
  <meta name="google-site-verification" content={googleSiteVerification} />
</head>
