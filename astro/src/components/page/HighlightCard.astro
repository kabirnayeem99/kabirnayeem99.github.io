---
import type { BotanicalName } from "../../lib/botanicals";
import { isTallBotanical } from "../../lib/notebook";
import { assetHref, type ContentCard } from "../../lib/work-project-content";
import Botanical from "./Botanical.astro";

interface Props {
  readonly card: ContentCard;
  readonly botanical?: BotanicalName;
}

const { card, botanical } = Astro.props;
const currentRoute = Astro.url.pathname.replace(/^\/+/, "") || "index.html";
---

<article class="highlight">
  <span class="peel-flap" aria-hidden="true"></span>
  {
    botanical ? (
      <Botanical
        name={botanical}
        class={isTallBotanical(botanical) ? "pinned pinned--tall" : "pinned"}
      />
    ) : null
  }
  <h3>
    {
      card.href ? (
        <a href={card.href} target="_blank" rel="noreferrer">
          {card.title}
        </a>
      ) : (
        card.title
      )
    }
  </h3>
  {card.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
  {
    card.bullets.length > 0 ? (
      <ul>
        {card.bullets.map((bullet) => (
          <li set:html={bullet} />
        ))}
      </ul>
    ) : null
  }
  {
    card.images && card.images.length > 0 ? (
      <div class="highlight-prints">
        {card.images.map((image) => (
          <figure class="print" style={`flex-grow:${(image.width / image.height).toFixed(3)}`}>
            <img
              src={assetHref(currentRoute, image.src)}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))}
      </div>
    ) : null
  }
  {card.meta ? <p class="meta">{card.meta}</p> : null}
</article>
